{
  "name": "canopy-property",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir .ssr && node scripts/prerender.mjs",
    "build:client": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "compress:video": "node scripts/compress-video.mjs",
    "optimize:photos": "node scripts/optimize-photos.mjs",
    "build:logo": "node scripts/build-logo.mjs"
  },
  "dependencies": {
    "gsap": "^3.13.0",
    "lucide-react": "^0.544.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "ffmpeg-static": "^5.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "ffmpeg-static@5.3.0": true
  }
}
